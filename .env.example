# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://...
DIRECT_URL=postgresql://...

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Secret shared with Make scenario for webhook authentication.
# Generate with: openssl rand -hex 32
MAKE_WEBHOOK_SECRET=

# WhatsApp QR (admin pools)
# Phone number in international format without +, e.g. 393331234567
KUBRI_WHATSAPP_NUMBER=
KUBRI_WHATSAPP_MESSAGE_TEMPLATE=

# Semantic matching — Supabase Edge Function proxying Mistral embeddings (1024-dim)
SUPABASE_EDGE_FUNCTION_URL=https://<project-ref>.supabase.co/functions/v1
EMBEDDING_TIMEOUT_MS=10000

# Mistral API — used both by the embedding Edge Function (as a Supabase secret)
# and directly server-side by the LLM reranker on the JD detail page
MISTRAL_API_KEY=

# LLM rerank cache TTL (default 24 hours). The "Aggiorna match" button on
# the JD page and any JD edit invalidate the cache regardless of this value.
LLM_RERANK_CACHE_TTL_MS=86400000

# Cron (Vercel) — secret protecting scheduled jobs like /api/cron/regenerate-embeddings
CRON_SECRET=

# Upstash Redis — shared cache for the LLM reranker results. REQUIRED in
# production (Vercel serverless): without these, the cache falls back to
# in-process LRU which is effectively a no-op across cold starts. Create
# a free DB at https://console.upstash.com and paste the REST URL + token
# below.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
