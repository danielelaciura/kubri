# Kubri dashboard — environment variables (template).
# Copy to apps/dashboard/.env.local (dev) — .env.prod is only for running Prisma against prod.
# Production runtime values live in Vercel (Production / Preview).
# See docs/setup/candidate-landing-setup.md for the third-party setup.

# --- Database (Supabase Postgres) --------------------------------------------
# Transaction pooler, port 6543 (runtime queries).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-2.pooler.supabase.com:6543/postgres
# Session pooler, port 5432 (Prisma migrate). Prisma reads it first via prisma.config.ts.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-2.pooler.supabase.com:5432/postgres

# --- Supabase (auth, storage, edge functions) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Public anon key (also used by the browser for signed CV uploads).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Embedding Edge Function base URL.
SUPABASE_EDGE_FUNCTION_URL=https://<project-ref>.supabase.co/functions/v1
EMBEDDING_TIMEOUT_MS=10000

# --- App ---------------------------------------------------------------------
# Canonical public URL: email links and printable landing QR codes.
# Inlined at build time: redeploy after changing it on Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Inbound webhooks --------------------------------------------------------
# Shared with the Make scenario. Generate with: openssl rand -hex 32
MAKE_WEBHOOK_SECRET=
# Shared with the Assessment app (same value there). openssl rand -hex 32
ASSESSMENT_WEBHOOK_SECRET=
# Pool externalKey for assessment candidates. Defaults to "global".
ASSESSMENT_POOL_KEY=global

# --- Mistral (CV OCR + extraction, JD rerank, competence report) -------------
# Use the paid (Scale) plan in production: CVs are personal data.
MISTRAL_API_KEY=
# Optional. Competence report LLM timeout (default 20000).
# MISTRAL_TIMEOUT_MS=20000
# JD rerank cache TTL (default 24 h).
LLM_RERANK_CACHE_TTL_MS=86400000

# --- Upstash Redis (rerank cache + landing rate limits) ----------------------
# REQUIRED in production: without it the landing refuses every upload (fail-closed)
# and the rerank cache is a no-op. Optional locally (in-memory fallback).
# If the Vercel integration created KV_REST_API_URL/TOKEN, copy them here under these names.
UPSTASH_REDIS_REST_URL=https://<db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# --- Cron (Vercel) -----------------------------------------------------------
# Protects /api/cron/*. Vercel sends it automatically to its cron jobs.
CRON_SECRET=

# --- Email (Resend) — new-candidates digest ----------------------------------
RESEND_API_KEY=
# Must use a verified domain in production. Locally: "Kubri <onboarding@resend.dev>".
EMAIL_FROM="Kubri <onboarding@resend.dev>"

# --- WhatsApp (pool QR codes + landing WhatsApp button) ----------------------
# International format without +, e.g. 393331234567.
KUBRI_WHATSAPP_NUMBER=
KUBRI_WHATSAPP_MESSAGE_TEMPLATE=

# --- Public candidate landing (/candidati/<slug>) ----------------------------
# Cloudflare Turnstile. Production: real keys (widget for the prod hostname).
# Preview/local: Cloudflare test keys (always pass):
#   site 1x00000000000000000000AA  /  secret 1x0000000000000000000000000000000AA
# Without the secret, production refuses every upload.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# HMAC key for the upload binding cookie, >= 32 chars. openssl rand -base64 48
# Different value per environment.
LANDING_COOKIE_SECRET=
# Key for IP hashes (rate limits, audit), >= 16 chars in production. openssl rand -hex 24
LANDING_IP_SALT=
# Google Maps Platform (server only, never NEXT_PUBLIC_): "Dove abiti?" prefill,
# autocomplete and address resolution. Enable Geocoding API + Places API (New),
# restrict the key to those two APIs. Blank = ISTAT comuni fallback (dev/preview).
GOOGLE_MAPS_API_KEY=
# Optional rate limits (integers; blank/invalid = default shown).
# LANDING_LIMIT_IP_HOUR=5
# LANDING_LIMIT_IP_DAY=20
# LANDING_LIMIT_PAGE_DAY=100
# LANDING_LIMIT_PAGE_EXTRACTIONS_DAY=100
# Global daily cap on paid extractions (all landings).
# LANDING_LIMIT_EXTRACTIONS_DAY=300
# LANDING_LIMIT_IMPORT_DAY=2
# Address autocomplete and resolution limits.
# LANDING_LIMIT_PLACE_SEARCH_IMPORT=40
# LANDING_LIMIT_PLACE_SEARCH_IP_HOUR=120
# LANDING_LIMIT_PLACE_RESOLVE_IMPORT=10

# --- Assessment app (apps/assessment) — set in THAT app, not in the dashboard ---
# Dashboard report endpoint called by the assessment app.
DASHBOARD_REPORT_URL=https://<dashboard-domain>/api/assessment/report

# --- OBSOLETE (no longer read by the code; remove from your env files and Vercel) ---
# NEXTAUTH_URL
# NEXTAUTH_SECRET
# MAKE_API_BASE_URL
# MAKE_API_TOKEN
# ENCRYPTION_KEY
# USE_PG_CANDIDATES
