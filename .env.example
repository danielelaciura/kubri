# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://...
DIRECT_URL=postgresql://...

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Secret shared with Make scenario for webhook authentication.
# Generate with: openssl rand -hex 32
MAKE_WEBHOOK_SECRET=

# Secret shared with the Assessment app for its candidate webhook.
# Same value as ASSESSMENT_WEBHOOK_SECRET in the assessment app.
# Generate with: openssl rand -hex 32
ASSESSMENT_WEBHOOK_SECRET=

# Pool (by externalKey) that assessment-sourced candidates are written to.
# The pool must already exist (admin UI / seed). Defaults to "global".
ASSESSMENT_POOL_KEY=global

# Assessment app → dashboard report endpoint (PDF generation proxy)
DASHBOARD_REPORT_URL=

# WhatsApp QR (admin pools)
# Phone number in international format without +, e.g. 393331234567
KUBRI_WHATSAPP_NUMBER=
KUBRI_WHATSAPP_MESSAGE_TEMPLATE=

# Semantic matching — Supabase Edge Function proxying Mistral embeddings (1024-dim)
SUPABASE_EDGE_FUNCTION_URL=https://<project-ref>.supabase.co/functions/v1
EMBEDDING_TIMEOUT_MS=10000

# Mistral API — used both by the embedding Edge Function (as a Supabase secret)
# and directly server-side by the LLM reranker on the JD detail page
MISTRAL_API_KEY=

# LLM rerank cache TTL (default 24 hours). The "Aggiorna match" button on
# the JD page and any JD edit invalidate the cache regardless of this value.
LLM_RERANK_CACHE_TTL_MS=86400000

# Cron (Vercel) — secret protecting scheduled jobs like /api/cron/regenerate-embeddings
CRON_SECRET=

# Upstash Redis — shared cache for the LLM reranker results. REQUIRED in
# production (Vercel serverless): without these, the cache falls back to
# in-process LRU which is effectively a no-op across cold starts. Create
# a free DB at https://console.upstash.com and paste the REST URL + token
# below.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email notifications (Resend) — new-candidates digest
# Get an API key at https://resend.com. EMAIL_FROM must use a verified domain in
# production; for local testing use "Kubri <onboarding@resend.dev>" (only sends to
# your own Resend account address until a domain is verified).
RESEND_API_KEY=
EMAIL_FROM="Kubri <onboarding@resend.dev>"

# Public base URL used to build dashboard links inside emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public candidate landing (/candidati/<slug>)
# Cloudflare Turnstile — without the secret, uploads are refused in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 32+ random chars (minimum 32 enforced): HMAC for the import binding cookie.
LANDING_COOKIE_SECRET=
# Random salt for IP hashes in rate-limit keys and audit logs.
# In production it must be at least 16 chars (hashIp throws otherwise).
LANDING_IP_SALT=
# NOTE: UPSTASH_REDIS_REST_URL / _TOKEN above are REQUIRED in production for the landing.
# Landing rate limits (optional; defaults shown). Integers; blank/invalid = default.
# LANDING_LIMIT_IP_HOUR=5
# LANDING_LIMIT_IP_DAY=20
# LANDING_LIMIT_PAGE_DAY=100
# LANDING_LIMIT_PAGE_EXTRACTIONS_DAY=100
# LANDING_LIMIT_EXTRACTIONS_DAY=300
# LANDING_LIMIT_IMPORT_DAY=2
