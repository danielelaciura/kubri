NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
# Local Docker Postgres (docker-compose.yml). Must always target ?schema=bot.
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/kubri_bot_dev?schema=bot
# NLU (plan 06). Only the real LLM needs the key: `campaigns simulate --nlu llm` and the worker.
MISTRAL_API_KEY=
# NLU_INTERPRET_MODEL=mistral-small-latest
# NLU_TRANSLATE_MODEL=mistral-small-latest
# NLU_FALLBACK_MODEL=mistral-medium-latest
# NLU_TIMEOUT_MS=15000
# NLU_HISTORY_MESSAGES=3
# NLU_PRICES={"mistral-small-latest":{"inputPerMTok":0,"outputPerMTok":0}}
