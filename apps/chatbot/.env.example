NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
# Local Docker Postgres (docker-compose.yml). Must always target ?schema=bot.
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/kubri_bot_dev?schema=bot
# NLU (plan 06). Only the real LLM needs the key: `campaigns simulate --nlu llm` and the worker.
MISTRAL_API_KEY=
# NLU_INTERPRET_MODEL=mistral-small-latest
# NLU_TRANSLATE_MODEL=mistral-small-latest
# NLU_FALLBACK_MODEL=mistral-medium-latest
# NLU_TIMEOUT_MS=15000
# NLU_HISTORY_MESSAGES=3
# NLU_PRICES={"mistral-small-latest":{"inputPerMTok":0,"outputPerMTok":0}}
# Runtime (plan 08). All optional.
# DEBOUNCE_MS=3000
# DEBOUNCE_MAX_WAIT_MS=10000
# TURN_NLU_DEADLINE_MS=20000
# SEND_LEASE_MS=60000
# SEND_MAX_ATTEMPTS=5
# WORKER_BATCH_SIZE=4
# QUEUE_SCHEMA=bot_queue
# INTERACTIVE_MESSAGES=true
# Direct / session connection for pg-boss (port 5432, never the 6543 transaction pooler).
# Required in production; in development and test it falls back to DATABASE_URL.
# QUEUE_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/kubri_bot_dev
# Key of the consent proof hash (HMAC-SHA256, >= 32 chars). Required by the worker; keep it
# in the secret manager and never rotate it in place (old proofs would stop matching).
# CONSENT_HASH_SECRET=
# WhatsApp (plan 09). The web process needs the two secrets; the tokens of the numbers are
# environment variables NAMED in each number's configuration (senders add --token-secret).
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_GRAPH_VERSION=v23.0
# Kubri dashboard (plan 10). The worker sends candidates to
# {KUBRI_BASE_URL}/api/webhooks/chatbot/candidate with CHATBOT_WEBHOOK_SECRET (the same value
# as the dashboard's). Both or neither: with NODE_ENV=production both are required; elsewhere,
# without them, kubri-webhook jobs go to the dead letter queue (reason not_configured).
# KUBRI_BASE_URL=http://localhost:3001
# CHATBOT_WEBHOOK_SECRET=
