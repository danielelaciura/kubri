{
  "name": "@kubri/chatbot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "DATABASE_URL= prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project scenarios",
    "test:watch": "vitest --project unit --project scenarios",
    "test:scenarios": "vitest run --project scenarios",
    "test:integration": "vitest run --project integration",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "cli": "tsx --env-file-if-exists=.env src/cli/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.0",
    "eslint": "^9.39.4",
    "prettier": "^3.9.10",
    "prisma": "^7.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.2",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "commander": "^15.0.0",
    "pg": "^8.20.0",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "zod": "^4.3.6"
  }
}
