{
  "name": "kubri",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:dashboard": "pnpm --filter kubri-dashboard dev",
    "dev:assessment": "pnpm --filter @kubri/assessment dev",
    "chatbot:cli": "pnpm --filter @kubri/chatbot cli",
    "chatbot:test": "pnpm --filter @kubri/chatbot test",
    "build": "pnpm -r build",
    "test": "vitest run"
  },
  "devDependencies": {
    "jsdom": "^29.0.1",
    "vitest": "^4.1.2"
  }
}
