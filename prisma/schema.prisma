generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN_KUBRI
  ORG_ADMIN
  ORG_MEMBER
}

enum NotifyFrequency {
  DAILY
  WEEKLY
}

model Organization {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  slug            String   @unique
  createdAt       DateTime @default(now())
  settings        Json?

  users           User[]
  candidateNotes  CandidateNote[]
  auditLogs       AuditLog[]
  jobDescriptions JobDescription[]
  pools           OrganizationPool[]
  candidateLists  CandidateList[]
}

model Pool {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  externalKey String?  @unique
  isGlobal    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidates    Candidate[]
  organizations OrganizationPool[]
}

model OrganizationPool {
  organizationId String       @db.Uuid
  poolId         String       @db.Uuid
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pool           Pool         @relation(fields: [poolId], references: [id], onDelete: Restrict)

  @@id([organizationId, poolId])
  @@index([poolId])
}

model User {
  id             String    @id @db.Uuid
  email          String    @unique
  name           String
  role           Role      @default(ORG_MEMBER)
  organizationId String?   @db.Uuid
  createdAt       DateTime  @default(now())
  lastLoginAt     DateTime?
  termsAcceptedAt DateTime?
  notifyEnabled   Boolean         @default(false)
  notifyFrequency NotifyFrequency @default(WEEKLY)
  lastNotifiedAt  DateTime?

  organization    Organization?    @relation(fields: [organizationId], references: [id])
  candidateNotes  CandidateNote[]
  auditLogs       AuditLog[]
  jobDescriptions JobDescription[]
  candidateLists       CandidateList[]
  listMembershipsAdded CandidateListMembership[]
}

model CandidateNote {
  id             String   @id @default(uuid()) @db.Uuid
  candidateId    String   @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  content        String
  createdAt      DateTime @default(now())

  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([organizationId])
}


model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @db.Uuid
  organizationId String?  @db.Uuid
  action         String
  resourceType   String
  resourceId     String
  metadata       Json?
  createdAt      DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
}

// NOTE: public.members_with_status is a Postgres view (see 20260423_supabase_auth_trigger migration).
// It is queried from app code via prisma.$queryRaw — not declared as a Prisma model because
// Prisma's migrate tooling would otherwise try to create a physical table with the same name.

model JobDescription {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @db.Uuid
  createdByUserId      String?  @db.Uuid
  name                 String
  locationRaw          String
  locationMunicipality String?
  locationProvince     String?
  locationRegion       String?
  description          String
  skills               String[]
  searchRadiusKm       Int      @default(25)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  embedding            Unsupported("vector(1024)")?
  embeddingText        String?
  embeddingUpdatedAt   DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
  @@index([organizationId, createdAt])
}

model Candidate {
  id              String   @id @default(uuid()) @db.Uuid

  externalId      String

  firstName       String?
  lastName        String?
  birthday        String?
  countryOfOrigin String?
  address         String?
  latitude        Float?
  longitude       Float?
  phone           String?

  workingPermit   Boolean?
  meanOfTransport String?
  drivingLicense  Boolean?

  educationAndTraining String[] @default([])
  workExperience       String[] @default([])
  skillsAndCompetences String[] @default([])

  language             String?
  additionalLanguages  String[] @default([])
  italianLevel         String?

  desiredJob               String?
  partTimePreference       Boolean?
  preferredLocation        String?
  jobConstraints           String?
  hasDesiredJobExperience  String?

  interviewLanguage   String?
  sourceOrganization  String?
  channel             String?

  rawPayload          Json

  sourceUpdatedAt     DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  embedding            Unsupported("vector(1024)")?
  embeddingText        String?
  embeddingUpdatedAt   DateTime?

  poolId String @db.Uuid
  pool   Pool   @relation(fields: [poolId], references: [id], onDelete: Restrict)

  notes           CandidateNote[]
  listMemberships CandidateListMembership[]

  @@unique([poolId, externalId])
  @@index([poolId])
  @@index([poolId, createdAt])
  @@index([poolId, lastName])
}

model CandidateList {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  name            String
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id])
  createdBy    User?                     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  members      CandidateListMembership[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model CandidateListMembership {
  listId        String   @db.Uuid
  candidateId   String   @db.Uuid
  addedByUserId String?  @db.Uuid
  createdAt     DateTime @default(now())

  list      CandidateList @relation(fields: [listId], references: [id], onDelete: Cascade)
  candidate Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  addedBy   User?         @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@id([listId, candidateId])
  @@index([candidateId])
}
